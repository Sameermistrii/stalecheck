# Copy to .env — read by both Bifrost (docker compose) and Next.js.
# Put each key right after the = with no spaces or quotes.

# Groq key (free): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tavily key: https://app.tavily.com  (redeem coupon GEEKROOM2 for 8,000 credits)
TAVILY_API_KEY=

BIFROST_URL=http://127.0.0.1:8080
# Optional model overrides (defaults: groq/openai/gpt-oss-120b, then groq/openai/gpt-oss-20b, then gemini/gemini-3.8-flash)
PRIMARY_MODEL=
FALLBACK_MODELS=
# Optional: override the virtual key (must match "value" in bifrost/config.json). Empty = built-in local key.
BIFROST_VIRTUAL_KEY=
